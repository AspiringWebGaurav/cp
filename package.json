{
  "name": "cp",
  "private": true,
  "version": "0.0.1",
  "author": "Gaurav Patil <https://gauravpatil.site>",
  "homepage": "https://cp.apps.gauravpatil.site",
  "license": "MIT",
  "description": "CP (Copy/Paste) — High-Performance Windows Copy/Paste Replacement Engine",
  "type": "module",
  "scripts": {
    "setup": "node scripts/vault.mjs unpack && npm run doctor",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "kill:dev": "node scripts/predev.mjs",
    "dev:engine": "tauri dev",
    "build": "tauri build",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "test": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:playwright": "node scripts/test-playwright.mjs",
    "tauri": "tauri",
    "build:base": "npm run build && node scripts/upload-base.mjs",
    "upload:base": "node scripts/upload-base.mjs",
    "ship": "node scripts/ship.mjs",
    "ship:dummy": "node scripts/fast-push-dummy.mjs",
    "vault:pack": "node scripts/vault.mjs pack",
    "vault:unpack": "node scripts/vault.mjs unpack",
    "vault:status": "node scripts/vault.mjs status",
    "doctor": "node scripts/doctor.mjs",
    "reset": "node scripts/reset-test.mjs",
    "reset:local": "node scripts/reset-local-test.mjs",
    "gphost:audit": "node scripts/audit-gphost.mjs",
    "gphost:clean": "node scripts/clean-gphost-dynamic.mjs",
    "owner:directive": "node scripts/owner-directive.mjs",
    "setup:tools": "powershell -ExecutionPolicy Bypass -File scripts/setup-tools.ps1",
    "rea": "rea-agents",
    "rea:doctor": "rea-agents mcp doctor"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.65.0",
    "rea-agents": "^6.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "prebuild-install": "https://github.com/prebuild/prebuild-install/archive/refs/tags/v7.1.3.tar.gz",
    "zod": "^4.6.7",
    "minimatch": "^11.0.5",
    "glob": "^14.0.4"
  },
  "allowScripts": {
    "esbuild": true,
    "frida": true
  }
}
