{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CP",
  "mainBinaryName": "cp",
  "version": "0.0.1",
  "identifier": "com.cp.engine",
  "build": {
    "beforeDevCommand": "npm run dev:frontend --silent",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CP",
        "width": 600,
        "height": 206,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "url": "index.html?mode=landing"
      },
      {
        "label": "transfer",
        "title": "CP",
        "width": 600,
        "height": 315,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "url": "index.html?mode=transfer"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Gaurav Patil",
    "homepage": "https://cp.apps.gauravpatil.site",
    "copyright": "Copyright © 2026 Gaurav Patil (https://gauravpatil.site). All rights reserved.",
    "license": "MIT",
    "licenseFile": "agreement.txt",
    "category": "Utility",
    "shortDescription": "High-Performance Windows Copy/Paste Acceleration Engine",
    "longDescription": "CP is an ultra-fast, local-first Windows copy/paste acceleration and replacement engine by Gaurav Patil. Learn more at https://cp.apps.gauravpatil.site",
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "startMenuFolder": "CP",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerIcon": "icons/uninstall.ico",
        "installerHooks": "hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
